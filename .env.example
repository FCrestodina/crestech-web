# URL pública del sitio (para canonical, OG y sitemap). Dominio definitivo.
NEXT_PUBLIC_SITE_URL=https://crestech.com.ar

# Umami Cloud (plan Hobby). Pegá acá el website ID que da cloud.umami.is.
# Sin esta variable, el analytics simplemente no se carga.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Opcional: solo si usás un script self-host. Por defecto usa cloud.umami.is.
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# API key de Resend para el envío de leads por email (/api/lead).
# Sin esta variable, el endpoint responde 200 con "no_configurado" y el sitio
# degrada el formulario a WhatsApp (comportamiento intencional, no es un error).
RESEND_API_KEY=

# Opcional: destino y remitente del email de lead. Si no se setean, se usan
# los defaults hardcodeados en src/app/api/lead/route.ts.
# LEAD_EMAIL_TO=devfrancocrestodina@gmail.com
# LEAD_EMAIL_FROM=Crestech Web <onboarding@resend.dev>

# Opcional: Meta Pixel ID para retargeting de Ads. Sin esta variable, el pixel
# no se renderiza y la CSP no se afloja hacia Facebook (ver next.config.ts).
# NEXT_PUBLIC_META_PIXEL_ID=
